{
  "name": "@strata/cli",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "strata": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --out-dir dist",
    "dev": "tsup src/index.ts --watch --format esm --dts --out-dir dist",
    "test": "vitest run --passWithNoTests",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@strata/core": "1.0.0",
    "commander": "^14.0.1",
    "nanospinner": "^1.2.2",
    "open": "^10.2.0",
    "picocolors": "^1.1.1",
    "sirv": "^3.0.2"
  }
}
